<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Initial Import Form -->
    <record id="view_import_wizard_form" model="ir.ui.view">
        <field name="name">sbs.import.wizard.form</field>
        <field name="model">sbs.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Excel Data">
                <sheet>
                    
                    <group>
                        <field name="from_doc" invisible="1"/>
                    </group>
                    
                    <!-- ─── Template Selection ─── -->
                    <group string="Import Configuration">
                        
                        <field name="supplier_id" />
                        <field name="template_id"   options="{'no_create': True, 'no_open': True}"/>
                        
                    </group>
                    
                    <group>
                        <group invisible="from_doc==True">
                            <field name="file" filename="file_name" 
                                   required="not from_doc"/>
                            <field name="file_name" invisible="1"/>
                        </group>
                    </group>

                    <group>
                        <group invisible="from_doc==False">
                            <field name="document_id" 
                                   domain="[('mimetype', 'in', ['application/vnd.openxmlformats-officedocument.spreadsheetml.sheet', 'application/vnd.ms-excel'])]" 
                                   required="from_doc"/>
                        </group>
                    </group>
                    
                    <footer>
                        <button name="action_import" string="Import" 
                                type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" 
                                special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- Results View (بدون تغییر) -->
    <record id="view_import_wizard_results" model="ir.ui.view">
        <field name="name">sbs.import.wizard.results</field>
        <field name="model">sbs.import.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="alert alert-info">
                        <field name="total_imported"/> records imported successfully<br/>
                        Import Number: <field name="import_number" readonly="1"/><br/>
                    </div>

                    <div class="alert alert-warning" invisible="unstated_note == ''">
                        <strong>Not stated in the file — confirm with the supplier:</strong>
                        <field name="unstated_note" readonly="1" widget="text" nolabel="1"
                               style="white-space: pre-wrap; margin-top: 6px;"/>
                    </div>

                    <div class="alert alert-danger" invisible="result_error == ''">
                        <strong>Errors:</strong>
                        <div style="max-height: 300px; overflow-y: auto; border: 1px solid #ccc; background: #fefefe; padding: 8px; margin-top: 8px;">
                            <field name="result_error" readonly="1" widget="text" 
                                style="white-space: pre-wrap; font-family: monospace; font-size: 13px;"/>
                        </div>
                    </div>

                    <div class="alert alert-danger" invisible="cleanup_msg == ''">
                        <strong>CleanUP Message:</strong>
                        <div style="max-height: 300px; overflow-y: auto; border: 1px solid #ccc; background: #fefefe; padding: 8px; margin-top: 8px;">
                            <field name="cleanup_msg" readonly="1" widget="text" 
                                style="white-space: pre-wrap; font-family: monospace; font-size: 13px;"/>
                        </div>
                    </div>

                    <footer>
                        <button name="action_new_import" string="Import Another" 
                                type="object" class="btn-secondary"/>
                        <button name="action_view_imported" string="View Imported" 
                                type="object" class="btn-primary" 
                                invisible="result_error != ''"/>
                        <button string="Close" class="btn-secondary" 
                                special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Wizard Action -->
    <record id="action_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Excel Data</field>
        <field name="res_model">sbs.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_import_wizard_form"/>
        <field name="target">new</field>
        <field name="binding_model_id" eval="False"/>
        <field name="binding_view_types">list,form</field>
    </record>
    
</odoo>
