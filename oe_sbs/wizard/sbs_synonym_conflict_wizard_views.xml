<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sbs_synonym_conflict_wizard_form" model="ir.ui.view">
        <field name="name">sbs.synonym.conflict.wizard.form</field>
        <field name="model">sbs.synonym.conflict.wizard</field>
        <field name="arch" type="xml">
            <form string="Mapping Conflict">
                <div class="alert alert-warning" role="alert">
                    <strong>This mapping conflicts with the dictionary.</strong>
                </div>
                <field name="message" nolabel="1" readonly="1"
                       class="o_field_text" style="white-space:pre-wrap;"/>
                <p class="mt-3">
                    How would you like to resolve it?
                </p>
                <footer>
                    <button name="action_remove_existing" type="object"
                            string="Remove the previous one" class="btn-primary"/>
                    <button name="action_skip_conflicting" type="object"
                            string="Keep previous, skip this" class="btn-secondary"/>
                    <button name="action_cancel" type="object"
                            string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
