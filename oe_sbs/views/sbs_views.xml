    <record id="view_sbs_data_form" model="ir.ui.view">
        <field name="name">sbs.data.form</field>
        <field name="model">sbs.data</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>

                         <field name="import_number"/>

                        <field name="import_date"/>
                        <field name="end_date"/>
                        <field name="ean"/>
                        <field name="product_name"/>
                        <field name="uom_id"/>
                        <field name="case_size"/>
                        <field name="layer"/>
                        <field name="pallet"/>
                        <field name="supplier_name" groups="oe_sbs.group_sbs_admin,oe_sbs.group_sbs_purchase"/>
                        <field name="supplier_code"   optional="hide"/>
                        <field name="supplier_id"   groups="oe_sbs.group_sbs_admin,oe_sbs.group_sbs_purchase"/>

                    </group>
                    <group>
                        <field name="supplier_unit_price" groups="oe_sbs.group_sbs_admin,oe_sbs.group_sbs_purchase"/>
                        <field name="currency_id"/>
                        <field name="converted_price" groups="oe_sbs.group_sbs_admin,oe_sbs.group_sbs_purchase"/>
                        <field name="converted_rate"  groups="oe_sbs.group_sbs_admin,oe_sbs.group_sbs_purchase"/>

                        <field name="selling_price"  groups="oe_sbs.group_sbs_admin,oe_sbs.group_sbs_sales" optional="hide"/>
                        <field name="selling_price_2" groups="oe_sbs.group_sbs_admin,oe_sbs.group_sbs_sales"/>
                    </group>
                    <group>
                        <field name="rank"/>
                        <field name="no_of_ranks"/>
                        <field name="excel_filename" readonly="1"  groups="oe_sbs.group_sbs_admin,oe_sbs.group_sbs_purchase"/>
                        <field name="note"/>
                        <field name="lead_time"/>
                        <field name="moq"/>
                        <field name="mov"/>
                        <field name="availabale_qty"/>
                        <field name="incoterms"/>
                        <field name="t1_t2"/>
                        <field name="payment_term"/>
                        <field name="coo"/>
                         <field name="is_expired"  groups="oe_sbs.group_sbs_admin,oe_sbs.group_sbs_purchase" />
                        
                    </group>
                </sheet>
            </form>
        </field>
    </record>


     <!-- Search View -->
    <record id="view_sbs_data_search" model="ir.ui.view">
        <field name="name">sbs.data.search</field>
        <field name="model">sbs.data</field>
        <field name="arch" type="xml">
            <search>
                <!-- Basic search fields -->
                <field name="ean" string="Barcode"/>
                <field name="product_name" string="Product Name"/>
                <field name="supplier_name" string="Supplier Name"/>
                <field name="supplier_code" string="Supplier Code"/>

                <field name="excel_filename" string="Excel File"/>
                <field name="import_number" string="Import Number"/>
                
                <!-- Filters -->
                <!--
                <filter string="Current Import" name="current_import" domain="[('import_number','=',context.get('default_import_number'))]"/>
                <filter string="Imported Today" name="today" domain="[('import_date','=',current_date)]"/>
                -->
                 <!-- No default search field -->
                <filter string="Not Expired" name="ean" domain="[('is_expired','=',False)]"/>
                <filter string="Expired" name="ean" domain="[('is_expired','=',True)]"/>

                <!--<filter string="Search by EAN" name="ean" domain="[('ean', 'ilike', self)]"/>
                <filter string="Search by Product" name="product" domain="[('product_name', 'ilike', self)]"/>-->
                <!-- Group By options -->
                <group>
                    <filter string="Excel File" name="group_by_file" context="{'group_by':'excel_filename'}"/>
                    <filter string="Import Number" name="group_by_import" context="{'group_by':'import_number'}"/>
                    <filter string="Supplier" name="group_by_supplier" context="{'group_by':'supplier_name'}"/>
                    <filter string="Import Date" name="group_by_date" context="{'group_by':'import_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_sbs_data_search_sales" model="ir.ui.view">
        <field name="name">sbs.data.search.sales</field>
        <field name="model">sbs.data</field>
        <field name="arch" type="xml">
            <search>
                <!-- فقط فیلدهایی که فروشنده‌ها می‌تونن ببینند -->
                <field name="ean" string="Barcode"/>
                <field name="product_name" string="Product Name"/>
                <field name="import_number" string="Import Number"/>
                <field name="supplier_code" string="Supplier Code"/>


                <filter string="Not Expired" name="ean" domain="[('is_expired','=',False)]"/>
                <filter string="Expired" name="ean" domain="[('is_expired','=',True)]"/>


                
                <!-- Group By محدود -->
                <group>
                    <filter string="Import Number" name="group_by_import" context="{'group_by':'import_number'}"/>
                    <filter string="Import Date" name="group_by_date" context="{'group_by':'import_date'}"/>
                </group>
            </search>
        </field>
    </record>


