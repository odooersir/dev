    <!-- Add SBS-status filters + a state search field to the Documents search,
         so users can filter documents by their SBS state and clear it freely. -->
    <record id="documents_view_search_sbs" model="ir.ui.view">
        <field name="name">documents.search.oe_sbs.state</field>
        <field name="model">documents.document</field>
        <field name="inherit_id" ref="documents.document_view_search"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="state" string="SBS Status"/>
                <field name="import_number" string="Import Number"/>
                <field name="template_id" string="Import Mapping"/>
            </field>
            <filter name="documents" position="after">
                <separator/>
                <filter string="Manually Sent" name="sbs_manual"
                        domain="[('state','=','sent_to_sbs')]"/>
                <filter string="Auto Sent" name="sbs_auto"
                        domain="[('state','=','auto_sent_to_sbs')]"/>
                <filter string="Waiting For Mapping" name="sbs_waiting"
                        domain="[('state','=','no_template')]"/>
                <filter string="Reject" name="sbs_reject"
                        domain="[('state','=','reject')]"/>
                <separator/>
                <filter string="SBS Status" name="group_by_state"
                        context="{'group_by':'state'}"/>
            </filter>
        </field>
    </record>

</odoo>