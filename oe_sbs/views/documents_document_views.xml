<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Read-only Excel viewer opened from the list-row 'Preview' button.
         Uses the same SheetJS grid as the import-template mapper. -->
    <record id="documents_document_view_excel_preview_form" model="ir.ui.view">
        <field name="name">documents.document.excel.preview.form</field>
        <field name="model">documents.document</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <form string="Excel Preview" create="false" edit="false">
                <sheet>
                    <div class="oe_title mb-2">
                        <h2><field name="name" readonly="1" nolabel="1"/></h2>
                    </div>
                    <field name="sbs_is_spreadsheet" invisible="1"/>
                    <!-- The widget never reads this field's value: it pulls the
                         bytes through sbs_get_file_b64(). It is bound to
                         'mimetype' simply because that field always exists on
                         documents.document, whereas 'datas' may not. -->
                    <field name="mimetype" widget="excel_viewer" nolabel="1"
                           readonly="1" options="{'max_rows': 300}"/>
                </sheet>
                <footer>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>


    <record id="documents_view_list" model="ir.ui.view">
        <field name="name">documents.list.oe_custom</field>
        <field name="model">documents.document</field>
        <field name="inherit_id" ref="documents.documents_view_list"/>
        <field name="arch" type="xml">
           
            <xpath expr="//list/field[@name='tag_ids']" position="replace">
                 <field name="tag_ids" widget="many2many_tags"  options="{'color_field': 'color'}" readonly="not is_tag_editor" />
  
            </xpath>
          
          
            <xpath expr="//list" position="attributes">
                <attribute name="decoration-success">state in ('sent_to_sbs', 'auto_sent_to_sbs')</attribute>
                <attribute name="decoration-warning">state=='no_template'</attribute>
                <attribute name="decoration-danger">state=='reject'</attribute>
                <attribute name="decoration-muted">sbs_split_done == True or state in ('deleted_from_sbs', 'auto_deleted')</attribute>
            </xpath>

            <xpath expr="//list" position="inside"> 
                
                <field name="sbs_is_spreadsheet" column_invisible="1"/>
                <button name="action_sbs_preview_excel" type="object"
                        string="Preview" icon="fa-table"
                        invisible="not sbs_is_spreadsheet"
                        help="Open this spreadsheet in a full Excel viewer"/>
                <field name="template_id" string="Import Mapping" class="text-center"
                       widget="sbs_open_link"
                       options="{'res_model': 'sbs.import.template', 'id_field': 'template_id', 'name': 'Import Mapping'}"
                       optional="show" />
                <field name="import_number" string="Import Number"
                       widget="sbs_open_link"
                       options="{'res_model': 'sbs.data', 'domain_field': 'import_number', 'name': 'SBS Records'}"
                       optional="show" />
                <field name="old_import_number" optional="hide" />
                <field name="sbs_split_done" optional="hide"/>
                <field name="sbs_origin_id" optional="hide"/>
                <button name="action_sbs_retry" type="object"
                        string="Retry" icon="fa-refresh"
                        invisible="state not in ('reject', 'no_template')"
                        help="Queue this file for auto-send again (after fixing the template or supplier)"/>
                <field name="modifier" optional="show" />
                <field name="state" optional="show" widget="badge"
                       decoration-success="state == 'sent_to_sbs'"
                       decoration-info="state in ('approve', 'auto_sent_to_sbs')"
                       decoration-warning="state == 'no_template'"
                       decoration-danger="state == 'reject'"
                       decoration-muted="state in ('deleted_from_sbs', 'auto_deleted')"/>
                <field name="rejection_reason" string="Rejection Reason" optional="show" />
               
                
            </xpath>
            
        </field>
    </record>

