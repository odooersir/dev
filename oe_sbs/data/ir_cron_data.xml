<odoo>
  <data noupdate="0">

    <record id="ir_cron_compute_expired_ean" model="ir.cron">
      <field name="name">Compute Expired EAN</field>
      <field name="model_id" ref="model_sbs_data"/>
      <field name="state">code</field>
      <field name="code">model.compute_expired_ean()</field>

      <!-- اجرای روزانه -->
      <field name="interval_number">1</field>
      <field name="interval_type">days</field>

      <field name="nextcall" eval="(DateTime.now().replace(hour=0, minute=5, second=0, microsecond=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')" />


      <field name="active">True</field>
    </record>

  </data>
</odoo>
