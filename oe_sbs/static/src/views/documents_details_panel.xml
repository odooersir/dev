<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">



    <t t-name="oe_sbs.DocumentsDetailsPanel"    t-inherit="documents.DocumentsDetailsPanel"    t-inherit-mode="extension">

       
        <!-- xpath برای بخش tag_ids فقط در فایل‌ها (نه پوشه) -->
        <xpath expr="//div[@class='o_field_widget o_field_many2many_tags d-flex mb-3 w-100']" position="replace">
            <t t-if="() => env.user.has_group('oe_sbs.group_tag_editor')">
                <div class="o_field_widget o_field_many2many_tags d-flex mb-3 w-100">
                    <DocumentsDetailsMany2ManyTagsField
                        name="'tag_ids'"
                        readonly="userPermissionViewOnly"
                        record="record"
                        canCreate="true"
                        canQuickCreate="true"
                        canCreateEdit="true"
                        placeholder.translate="Add a tag..."
                        colorField="'color'"
                    />
                </div>
            </t>
            <t t-else="">
                <div class="text-muted mb-3 w-100">
                    <i class="fa fa-lock me-1"/> You don’t have permission to view tags.
                </div>
            </t>
        </xpath>

    </t>











</templates>