<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================================================================
         SHOP PAGE - PRODUCT CARD MODIFICATIONS
         ======================================================================== -->

    <!-- 1. Remove price from product card -->
    <template id="custom_products_item_remove_price"    inherit_id="website_sale.products_item"    name="Remove Price from Product Card">
        <xpath expr="//div[hasclass('product_price')]" position="replace"/>
    </template>

    <!-- 2. Add barcode to product card -->
    <template id="custom_products_item_add_barcode"   inherit_id="website_sale.products_item"     name="Add Barcode to Product Card">
        <xpath expr="//h2[hasclass('o_wsale_products_item_title')]" position="after">
            <div t-if="product.barcode" class="text-muted small mt-1 font-monospace o_product_barcode">
                <i class="fa fa-barcode me-1"/>
                <span t-field="product.barcode"/>
            </div>
                
            <div t-if="product.brand_id" class="product_brand text-muted small">
                <i class="fa fa-tag"/> <span t-field="product.brand_id.name"/>
            </div>
            
            <!-- نمایش تعداد آفرها -->
            <div class="product_offers small mt-1">
                <span  class="badge badge-success me-1">
                    <t t-esc="product.valid_offers_count"/> valid offers
                </span>
                <span  class="badge badge-secondary">
                    <t t-esc="product.expired_offers_count"/> expired offers
                </span>
            </div>

        </xpath>
    </template>

    <!-- 3. External image for product card -->
     <!-- 1️⃣ استفاده از تصویر خارجی (image_url) برای PRIMARY و SECONDARY -->
    <template id="custom_products_item_external_images"  inherit_id="website_sale.products_item"  name="External Image URL for Product Card"  priority="12">
        
        <!-- تصویر اصلی (Primary Image) -->
        <xpath expr="//span[hasclass('oe_product_image_img_wrapper_primary')]" position="replace">
            <span class="oe_product_image_img_wrapper oe_product_image_img_wrapper_primary d-flex h-100 justify-content-center align-items-center">
                <!-- اگر image_url وجود داشت، از آن استفاده کن -->
                <t t-if="primary_image_holder.image_url">
                    <img 
                        t-att-src="primary_image_holder.image_url" 
                        t-att-alt="product.name"
                        class="oe_product_image_img h-100 w-100"
                        loading="lazy"
                        style="object-fit: contain;"
                    />
                </t>
                <!-- وگرنه از تصویر داخلی استفاده کن -->
                <t t-else="">
                     <img 
                        src="https://img.cliimax.io/awr3dxEq__0MAeCuu3w82ONS97QFbUkUlhTUBrgQdGk/plain/local:///climax1/product.template/789671/789671.jpg" 
                        alt="Default Product Image"
                        class="oe_product_image_img h-100 w-100"
                        loading="lazy"
                        style="object-fit: contain;"
                    />
                </t>
            </span>
        </xpath>

        <!-- تصویر ثانویه (Secondary Image) -->
        <xpath expr="//span[hasclass('oe_product_image_img_wrapper_secondary')]" position="replace">
            <span
                t-if="secondary_image_holder"
                class="oe_product_image_img_wrapper oe_product_image_img_wrapper_secondary h-100 justify-content-center align-items-center"
            >
                <!-- اگر secondary هم image_url داشت -->
                <t t-if="secondary_image_holder.image_url">
                    <img 
                        t-att-src="secondary_image_holder.image_url" 
                        t-att-alt="product.name"
                        class="oe_product_image_img_secondary h-100 w-100"
                        loading="lazy"
                        style="object-fit: contain;"
                    />
                </t>
                <!-- وگرنه از تصویر داخلی استفاده کن -->
                <t t-else="">
                    <img 
                        src="https://img.cliimax.io/awr3dxEq__0MAeCuu3w82ONS97QFbUkUlhTUBrgQdGk/plain/local:///climax1/product.template/789671/789671.jpg" 
                        alt="Default Product Image"
                        class="oe_product_image_img h-100 w-100"
                        loading="lazy"
                        style="object-fit: contain;"
                    />
                </t>
            </span>
        </xpath>


    </template>



    <!-- ================================================================
    CART PAGE — نام تامین‌کننده زیر نام محصول
    inherit از cart_lines چون ساختار Odoo 19 دیگر table ندارد
    ================================================================ -->
      
    <template id="marketplace_cart_supplier"
          inherit_id="website_sale.cart_lines"
          name="Marketplace Seller in Cart">

        <xpath expr="//t[@t-call='website_sale.cart_line_description_following_lines']"
            position="after">
            <t t-if="line.sbs_data_id">
                <div class="mp-cart-seller mt-1 mb-1">
                    <small class="text-muted d-inline-flex align-items-center gap-1">
                        <i class="fa fa-store" style="font-size:10px;"/>
                       <span style="font-size:11px;">
                            Offer List:
                            <a t-attf-href="/shop/offer/#{line.snapshot_import_number or line.sbs_data_id.import_number}"
                            class="fw-semibold text-decoration-none">
                                <strong t-esc="line.snapshot_import_number or line.sbs_data_id.import_number"/>
                            </a>
                        </span>
                    </small>
                </div>
            </t>
        </xpath>

        <xpath expr="//div[hasclass('o_cart_product_image')]" position="replace">
            <div class="o_cart_product_image">
                <t t-call="website_sale.cart_line_product_link">
                    <t t-if="line.product_id.image_url or line.product_template_id.image_url">
                        <img
                            t-att-src="line.product_id.image_url or line.product_template_id.image_url"
                            t-att-alt="line.name_short"
                            class="img border rounded"
                            loading="lazy"
                            style="object-fit: contain; width: 128px; height: 128px;"
                        />
                    </t>
                    <t t-else="">
                        <img
                            src="https://img.cliimax.io/awr3dxEq__0MAeCuu3w82ONS97QFbUkUlhTUBrgQdGk/plain/local:///climax1/product.template/789671/789671.jpg"
                            alt="Default Product Image"
                            class="img border rounded"
                            loading="lazy"
                            style="object-fit: contain; width: 128px; height: 128px;"
                        />
                    </t>
                </t>
            </div>
        </xpath>

         <xpath expr="//div[@id='cart_products']" position="before">
            <t t-if="mp_mov_violations">
                <div class="mp-mov-violations-wrapper mb-4">
 
                    <!-- Header -->
                    <div class="alert alert-warning border-warning d-flex align-items-start gap-3 mb-0 rounded-bottom-0"
                         role="alert"
                         style="border-bottom: 0 !important;">
                        <i class="fa fa-exclamation-triangle fa-lg text-warning mt-1 flex-shrink-0"/>
                        <div>
                            <strong style="font-size:14px;">
                                Minimum Order Value Not Reached
                            </strong>
                            <p class="mb-0 text-muted" style="font-size:13px;">
                                Please add more items to the following price lists to proceed to checkout.
                            </p>
                        </div>
                    </div>
 
                    <!-- Per-violation cards -->
                    <div class="border border-warning rounded-bottom overflow-hidden">
                        <t t-foreach="mp_mov_violations" t-as="viol">
 
                            <!-- ✅ محاسبه درصد به صورت جداگانه در t-set -->
                            <t t-set="mov_pct"
                               t-value="int(min((viol['current_value'] / viol['mov']) * 100, 100)) if viol['mov'] > 0 else 0"/>
 
                            <div t-attf-class="px-3 py-3 bg-white
                                    #{'border-bottom border-warning-subtle' if not viol_last else ''}">
 
                                <!-- Import number + % badge -->
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="fa fa-tag text-secondary" style="font-size:12px;"/>
                                        <span class="text-muted" style="font-size:12px;">Price List:</span>
                                        <strong style="font-size:13px;">
                                            #<t t-esc="viol['import_number']"/>
                                        </strong>
                                    </div>
                                    <!-- ✅ نمایش درصد بدون format string -->
                                    <span class="badge bg-warning text-dark" style="font-size:11px;">
                                        <t t-esc="mov_pct"/>% of MOV
                                    </span>
                                </div>
 
                                <!-- Progress bar -->
                                <!-- ✅ width هم از متغیر mov_pct استفاده می‌کند -->
                                <div class="progress mb-2" style="height:8px; border-radius:4px;">
                                    <div
                                        class="progress-bar bg-warning"
                                        role="progressbar"
                                        t-attf-style="width: #{mov_pct}%;"
                                        t-att-aria-valuenow="viol['current_value']"
                                        aria-valuemin="0"
                                        t-att-aria-valuemax="viol['mov']"
                                    />
                                </div>
 
                                <!-- Values + remaining -->
                                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                    <div class="d-flex gap-3 flex-wrap">
                                        <span style="font-size:12px; color:#6c757d;">
                                            Current:
                                            <strong class="text-dark">
                                                $<t t-esc="'%.2f' % viol['current_value']"/>
                                            </strong>
                                        </span>
                                        <span style="font-size:12px; color:#6c757d;">
                                            Required:
                                            <strong class="text-dark">
                                                $<t t-esc="'%.2f' % viol['mov']"/>
                                            </strong>
                                        </span>
                                    </div>
                                    <span class="text-danger fw-semibold" style="font-size:12px;">
                                        <i class="fa fa-plus-circle me-1"/>
                                        $<t t-esc="'%.2f' % viol['remaining']"/> more needed
                                    </span>
                                </div>
 
                            </div>
                        </t>
                    </div>
 
                </div>
            </t>
        </xpath>

    </template>


    <!-- ================================================================
    ================================================================ -->
    <template id="custom_cart_summary"
            inherit_id="website_sale.cart_summary_content"
            name="Costom Cart Summary"
            priority="12">

        <xpath expr="//div[hasclass('o_cart_product_image')]" position="replace">
            <div class="o_cart_product_image position-relative">
                <t t-if="line.product_id.image_url or line.product_template_id.image_url">
                    <img
                        t-att-src="line.product_id.image_url or line.product_template_id.image_url"
                        t-att-alt="line.name_short"
                        class="img rounded"
                        loading="lazy"
                        style="object-fit: contain;"
                    />
                </t>
                <t t-else="">
                    <img
                        src="https://img.cliimax.io/awr3dxEq__0MAeCuu3w82ONS97QFbUkUlhTUBrgQdGk/plain/local:///climax1/product.template/789671/789671.jpg"
                        alt="Default Product Image"
                        class="img rounded"
                        loading="lazy"
                        style="object-fit: contain;"
                    />
                </t>
                <span class="o_cart_item_count badge bg-secondary position-absolute top-0 start-100 translate-middle">
                    <t t-out="int(line.product_uom_qty)" />
                    <i
                        t-if="line._get_shop_warning(clear=False)"
                        class="fa fa-warning"
                        role="img"
                        t-att-title="line._get_shop_warning()"
                        aria-label="Warning"
                    />
                </span>
            </div>
        </xpath>

    </template>


    <template
        id="shop_sbs_banner"
        inherit_id="website_sale.products"
        name="Shop – SBS Import Filter Banner"
    >
        <xpath expr="//header[@id='o_wsale_products_header']" position="before">
            <t t-if="sbs_import_number">
                <div class="alert alert-info border-0 rounded-0 mb-0 py-2 px-3"
                     role="alert">
                    <div class="d-flex align-items-center flex-wrap gap-2">
                        <i class="fa fa-tag fa-fw"/>
                       <span>
                            Offer list&#160;
                            <a t-attf-href="/shop/offer/#{sbs_import_number}"
                            class="fw-semibold text-reset">
                                <strong t-esc="sbs_import_number"/>
                            </a>
                            <!-- <t t-if="sbs_supplier_name">
                                &#160;—&#160;<t t-esc="sbs_supplier_name"/>
                            </t> -->
                            <t t-if="sbs_end_date">
                                &#160;—&#160; valid until&#160;<strong t-esc="sbs_end_date"/>
                            </t>
                        </span>
                        <a href="/shop"
                           class="ms-auto btn btn-sm btn-outline-secondary">
                            <i class="fa fa-times me-1"/>Clear filter
                        </a>
                    </div>
                </div>
            </t>
        </xpath>
    </template>


    
</odoo>
