<?xml version="1.0" encoding="utf-8" ?>
<odoo>

        <!-- views/templates.xml -->

        <!-- views/templates.xml -->

<template id="product_categories" name="Product Categories">
    <t t-call="website.layout">
        <div id="wrap">
            <div class="container py-5">
                
                <h2 class="mb-4" style="font-weight:700;">Shop by Category</h2>
                
                <div class="row g-4">
                    <t t-set="col_count" t-value="3"/>
                    <t t-set="items_per_col" t-value="(len(root_categories) + col_count - 1) // col_count"/>
                    
                    <t t-foreach="range(col_count)" t-as="col_idx">
                        <div class="col-md-4">
                            <t t-set="start_idx" t-value="col_idx * items_per_col"/>
                            <t t-set="end_idx" t-value="min((col_idx + 1) * items_per_col, len(root_categories))"/>
                            
                            <t t-foreach="root_categories[start_idx:end_idx]" t-as="root_cat">
                                <div class="mb-4">
                                    <!-- کتگوری سطح اول -->
                                    <div class="mb-3">
                                        <span style="font-size:1.1rem; font-weight:600; color:#111827;">
                                            <t t-esc="root_cat.name"/>
                                        </span>
                                        <div style="font-size:0.8rem; color:#6b7280; margin-top:2px;">
                                            <a t-attf-href="/shop/category/#{root_cat.id}" 
                                               style="color:#6b7280; text-decoration:none;">
                                                <t t-esc="category_data[root_cat.id]['products']"/> products
                                            </a>
                                            in
                                            <a t-attf-href="/shop/category/#{root_cat.id}/offers"
                                               style="color:#6b7280; text-decoration:none;">
                                                <t t-esc="category_data[root_cat.id]['offers']"/> offers
                                            </a>
                                        </div>
                                    </div>
                                    
                                    <!-- کتگوری‌های سطح دوم -->
                                    <t t-foreach="root_cat.child_id" t-as="child_cat">
                                        <div class="ms-3 mb-2">
                                            <span style="font-size:0.95rem; font-weight:500; color:#374151;">
                                                <t t-esc="child_cat.name"/>
                                            </span>
                                            <div style="font-size:0.75rem; color:#6b7280; margin-top:2px;">
                                                <a t-attf-href="/shop/category/#{child_cat.id}"
                                                   style="color:#6b7280; text-decoration:none;">
                                                    <t t-esc="category_data[child_cat.id]['products']"/> products
                                                </a>
                                                in
                                                <a t-attf-href="/shop/category/#{child_cat.id}/offers"
                                                   style="color:#6b7280; text-decoration:none;">
                                                    <t t-esc="category_data[child_cat.id]['offers']"/> offers
                                                </a>
                                            </div>
                                            
                                            <!-- کتگوری‌های سطح سوم -->
                                            <t t-if="child_cat.child_id">
                                                <t t-foreach="child_cat.child_id" t-as="grandchild_cat">
                                                    <div class="ms-3 mb-2">
                                                        <span style="font-size:0.85rem; color:#4b5563;">
                                                            <t t-esc="grandchild_cat.name"/>
                                                        </span>
                                                        <div style="font-size:0.7rem; color:#6b7280; margin-top:2px;">
                                                            <a t-attf-href="/shop/category/#{grandchild_cat.id}"
                                                               style="color:#6b7280; text-decoration:none;">
                                                                <t t-esc="category_data[grandchild_cat.id]['products']"/> products
                                                            </a>
                                                            in
                                                            <a t-attf-href="/shop/category/#{grandchild_cat.id}/offers"
                                                               style="color:#6b7280; text-decoration:none;">
                                                                <t t-esc="category_data[grandchild_cat.id]['offers']"/> offers
                                                            </a>
                                                        </div>
                                                    </div>
                                                </t>
                                            </t>
                                        </div>
                                    </t>
                                </div>
                            </t>
                        </div>
                    </t>
                </div>
                
            </div>
        </div>
    </t>
</template>



<!-- صفحه آفرهای کتگوری -->
<template id="category_offers" name="Category Offers">
    <t t-call="website.layout">
        <div id="wrap">
            <div class="container py-5">

                <!-- Breadcrumb -->
                <nav class="mb-4" style="font-size:0.85rem; color:#6b7280;">
                    <a href="/shop/categories" style="color:#6b7280; text-decoration:none;">Categories</a>
                    <span class="mx-2">›</span>
                    <a t-attf-href="/shop/category/#{category.id}/offers"
                       style="color:#6b7280; text-decoration:none;">
                        <t t-esc="category.name"/>
                    </a>
                    <span class="mx-2">›</span>
                    <span>Offers</span>
                </nav>

                <!-- عنوان -->
                <h2 class="mb-4" style="font-weight:700;">
                    <t t-esc="category.name"/> — Active Offers
                </h2>

                <!-- جدول آفرها -->
                <t t-if="grouped_offers">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle" style="font-size:0.875rem;">
                            <thead style="background:#f9fafb; border-bottom:2px solid #e5e7eb;">
                                <tr>
                                    <th>Offer #</th>
                                    <th>Valid Until</th>
                                    <th>MOQ</th>
                                    <th>MOV</th>
                                    <th>Incoterms</th>
                                    <th>T1/T2</th>
                                    <th>Payment</th>
                                    <th>Lead Time</th>
                                    <th>Products</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="grouped_offers" t-as="offer">
                                    <tr>
                                        <td style="font-weight:600; color:#111827;">
                                            <t t-esc="offer['import_number']"/>
                                        </td>
                                        <td>
                                            <t t-if="offer['end_date']">
                                                <span t-att-style="'color:#dc2626; font-weight:500;' if offer['end_date'] &lt; today else 'color:#16a34a;'">
                                                    <t t-esc="offer['end_date']"/>
                                                </span>
                                            </t>
                                            <t t-else="">
                                                <span style="color:#9ca3af;">—</span>
                                            </t>
                                        </td>
                                        <td><t t-esc="offer['moq'] or '—'"/></td>
                                        <td><t t-esc="offer['mov'] or '—'"/></td>
                                        <td><t t-esc="offer['incoterms'] or '—'"/></td>
                                        <td><t t-esc="offer['t1_t2'] or '—'"/></td>
                                        <td><t t-esc="offer['payment_term'] or '—'"/></td>
                                        <td><t t-esc="offer['lead_time'] or '—'"/></td>
                                        <td>
                                            <span style="color:#6b7280;">
                                                <t t-esc="offer['product_count']"/>
                                            </span>
                                        </td>
                                        <td>
                                            <a t-attf-href="/shop/offer/#{offer['import_number']}"
                                               class="btn btn-sm"
                                               style="background:#111827; color:#fff; border-radius:6px; padding:4px 14px; text-decoration:none; font-size:0.8rem;">
                                                View
                                            </a>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>

                <t t-else="">
                    <p style="color:#6b7280;">No active offers found for this category.</p>
                </t>

            </div>
        </div>
    </t>
</template>




</odoo>
