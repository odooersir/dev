<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="cliimax_homepage" name="Cliimax Homepage">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">

                <!-- Announcement Bar -->
                <section class="clx-announce">
                    <div class="container-fluid">
                        <p class="text-center">
                            <span class="clx-announce-badge">NEW</span>
                            500+ verified suppliers now available — Start sourcing today
                        </p>
                    </div>
                </section>

                <!-- Hero -->
                <section class="clx-hero">
                    <div class="container">
                        <div class="row align-items-center">
                            <div class="col-lg-6 clx-hero-content">
                                <h1>Wholesale sourcing, <span>simplified</span></h1>
                                <p class="clx-hero-desc">
                                    Cliimax.ai connects buyers with trusted suppliers, making it easier to discover
                                    products, compare offers, and source with confidence through one streamlined B2B marketplace.
                                </p>
                                <p class="clx-hero-sub">
                                    Built for retailers, distributors, wholesalers, and resellers looking for a faster
                                    and more efficient way to trade.
                                </p>
                                <div class="d-flex gap-3 flex-wrap">
                                    <a href="/shop" class="clx-btn clx-btn-primary">
                                        <i class="fa fa-shopping-bag"></i> Start Sourcing
                                    </a>
                                    <a href="/contactus" class="clx-btn clx-btn-outline">
                                        <i class="fa fa-store"></i> Become a Supplier
                                    </a>
                                </div>
                            </div>
                            <div class="col-lg-6 mt-4 mt-lg-0">
                                <img class="clx-hero-img"
                                     src="https://images.unsplash.com/photo-1607082348824-0a96f2a4b9da?w=800&amp;q=80&amp;fit=crop"
                                     alt="Wholesale marketplace"/>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Metrics -->
                <section class="clx-metrics">
                    <div class="container">
                        <div class="row text-center">
                            <div class="col-6 col-md-3 py-3">
                                <div class="clx-metric-value">500+</div>
                                <div class="clx-metric-label">Verified Suppliers</div>
                            </div>
                            <div class="col-6 col-md-3 py-3">
                                <div class="clx-metric-value">10K+</div>
                                <div class="clx-metric-label">Trusted Brands</div>
                            </div>
                            <div class="col-6 col-md-3 py-3">
                                <div class="clx-metric-value">500K+</div>
                                <div class="clx-metric-label">Products Available</div>
                            </div>
                            <div class="col-6 col-md-3 py-3">
                                <div class="clx-metric-value">100%</div>
                                <div class="clx-metric-label">Authenticity Guaranteed</div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Brands -->
                <section class="clx-section-light">
                    <div class="container">
                        <div class="text-center mb-5">
                            <h2 class="clx-section-title">Popular Brands</h2>
                            <p class="clx-section-sub">Over 1,000 trusted global brands</p>
                        </div>
                        <div class="clx-grid-brands">
                            <a href="#" class="clx-card clx-card-brand">
                                <img src="https://images.unsplash.com/photo-1571781926291-c477ebfd024b?w=600&amp;q=80&amp;fit=crop" alt="L'Oréal"/>
                                <div class="clx-card-body"><h4>L'Oréal</h4></div>
                            </a>
                            <a href="#" class="clx-card clx-card-brand">
                                <img src="https://images.unsplash.com/photo-1556228720-195a672e8a03?w=600&amp;q=80&amp;fit=crop" alt="Nivea"/>
                                <div class="clx-card-body"><h4>Nivea</h4></div>
                            </a>
                            <a href="#" class="clx-card clx-card-brand">
                                <img src="https://images.unsplash.com/photo-1607006344380-b6775a0824a7?w=600&amp;q=80&amp;fit=crop" alt="Dove"/>
                                <div class="clx-card-body"><h4>Dove</h4></div>
                            </a>
                            <a href="#" class="clx-card clx-card-brand">
                                <img src="https://images.unsplash.com/photo-1608248597279-f99d160bfcbc?w=600&amp;q=80&amp;fit=crop" alt="Garnier"/>
                                <div class="clx-card-body"><h4>Garnier</h4></div>
                            </a>
                            <a href="#" class="clx-card clx-card-brand">
                                <img src="https://images.unsplash.com/photo-1522335789203-aabd1fc54bc9?w=600&amp;q=80&amp;fit=crop" alt="Maybelline"/>
                                <div class="clx-card-body"><h4>Maybelline</h4></div>
                            </a>
                            <a href="#" class="clx-card clx-card-brand">
                                <img src="https://images.unsplash.com/photo-1596462502278-27bfdc403348?w=600&amp;q=80&amp;fit=crop" alt="Estée Lauder"/>
                                <div class="clx-card-body"><h4>Estée Lauder</h4></div>
                            </a>
                            <a href="#" class="clx-card clx-card-brand">
                                <img src="https://images.unsplash.com/photo-1620916566398-39f1143ab7be?w=600&amp;q=80&amp;fit=crop" alt="Clinique"/>
                                <div class="clx-card-body"><h4>Clinique</h4></div>
                            </a>
                            <a href="#" class="clx-card clx-card-brand">
                                <img src="https://images.unsplash.com/photo-1487412947147-5cebf100ffc2?w=600&amp;q=80&amp;fit=crop" alt="MAC"/>
                                <div class="clx-card-body"><h4>MAC</h4></div>
                            </a>
                        </div>
                        <div class="text-center mt-5">
                            <a href="/shop/brands" class="clx-btn clx-btn-outline">
                                <i class="fa fa-th-large"></i> View All Brands
                            </a>
                        </div>
                    </div>
                </section>

                <!-- Categories -->
                <section class="clx-section-alt">
                    <div class="container">
                        <div class="text-center mb-5">
                            <h2 class="clx-section-title">Popular Categories</h2>
                            <p class="clx-section-sub">Explore our most sought-after product categories</p>
                        </div>
                        <div class="clx-grid-cats">
                            <a href="/shop?category=skincare" class="clx-card clx-card-cat">
                                <img src="https://images.unsplash.com/photo-1556228578-8c89e6adf883?w=400&amp;q=80&amp;fit=crop" alt="Skincare"/>
                                <div class="clx-card-body"><h3>Skincare</h3><p>150K+ products</p></div>
                            </a>
                            <a href="/shop?category=fragrance" class="clx-card clx-card-cat">
                                <img src="https://images.unsplash.com/photo-1541643600914-78b084683702?w=400&amp;q=80&amp;fit=crop" alt="Fragrance"/>
                                <div class="clx-card-body"><h3>Fragrance</h3><p>80K+ products</p></div>
                            </a>
                            <a href="/shop?category=haircare" class="clx-card clx-card-cat">
                                <img src="https://images.unsplash.com/photo-1527799820374-87591a0919c4?w=400&amp;q=80&amp;fit=crop" alt="Haircare"/>
                                <div class="clx-card-body"><h3>Haircare</h3><p>120K+ products</p></div>
                            </a>
                            <a href="/shop?category=makeup" class="clx-card clx-card-cat">
                                <img src="https://images.unsplash.com/photo-1512496015851-a90fb38ba796?w=400&amp;q=80&amp;fit=crop" alt="Makeup"/>
                                <div class="clx-card-body"><h3>Makeup</h3><p>100K+ products</p></div>
                            </a>
                            <a href="/shop?category=wellness" class="clx-card clx-card-cat">
                                <img src="https://images.unsplash.com/photo-1544367567-0f2fcb009e0b?w=400&amp;q=80&amp;fit=crop" alt="Wellness"/>
                                <div class="clx-card-body"><h3>Wellness</h3><p>60K+ products</p></div>
                            </a>
                            <a href="/shop?category=supplements" class="clx-card clx-card-cat">
                                <img src="https://images.unsplash.com/photo-1584308666744-24d5c474f2ae?w=400&amp;q=80&amp;fit=crop" alt="Supplements"/>
                                <div class="clx-card-body"><h3>Supplements</h3><p>90K+ products</p></div>
                            </a>
                        </div>
                        <div class="text-center mt-5">
                            <a href="/shop" class="clx-btn clx-btn-primary">
                                <i class="fa fa-th"></i> View All Categories
                            </a>
                        </div>
                    </div>
                </section>

                <!-- Why Cliimax -->
                <section class="clx-section-light">
                    <div class="container">
                        <h2 class="clx-section-title text-center mb-5">Why choose Cliimax.ai</h2>
                        <div class="row g-4">
                            <div class="col-md-6 col-lg-3">
                                <div class="clx-feature-card">
                                    <div class="clx-feature-icon"><i class="fa fa-shield"></i></div>
                                    <h3>Trusted Network</h3>
                                    <p>Every supplier is verified. Trade with confidence knowing you're working with legitimate businesses.</p>
                                </div>
                            </div>
                            <div class="col-md-6 col-lg-3">
                                <div class="clx-feature-card">
                                    <div class="clx-feature-icon"><i class="fa fa-search"></i></div>
                                    <h3>Easy Discovery</h3>
                                    <p>Browse 500K+ products across health &amp; beauty. Find exactly what you need, fast.</p>
                                </div>
                            </div>
                            <div class="col-md-6 col-lg-3">
                                <div class="clx-feature-card">
                                    <div class="clx-feature-icon"><i class="fa fa-bolt"></i></div>
                                    <h3>Faster Decisions</h3>
                                    <p>Compare prices, check availability, and place orders in minutes — not days.</p>
                                </div>
                            </div>
                            <div class="col-md-6 col-lg-3">
                                <div class="clx-feature-card">
                                    <div class="clx-feature-icon"><i class="fa fa-briefcase"></i></div>
                                    <h3>Built for B2B</h3>
                                    <p>Wholesale pricing, bulk ordering, and trade terms designed for your business.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- How It Works -->
                <section class="clx-section-alt">
                    <div class="container">
                        <h2 class="clx-section-title text-center mb-5">How it works</h2>
                        <div class="row g-4">
                            <div class="col-md-4">
                                <div class="clx-step">
                                    <div class="clx-step-num">1</div>
                                    <h3>Create your account</h3>
                                    <p>Sign up in minutes. No upfront fees, no commitments.</p>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="clx-step">
                                    <div class="clx-step-num">2</div>
                                    <h3>Browse and compare</h3>
                                    <p>Search our catalog, compare suppliers, and see wholesale prices instantly.</p>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="clx-step">
                                    <div class="clx-step-num">3</div>
                                    <h3>Order with confidence</h3>
                                    <p>Place orders directly through the platform. We handle the rest.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- CTA -->
                <section class="clx-cta">
                    <div class="container text-center">
                        <h2>Ready to simplify your sourcing?</h2>
                        <p>Join hundreds of businesses already trading on Cliimax.ai</p>
                        <div class="d-flex gap-3 justify-content-center flex-wrap">
                            <a href="/shop" class="clx-btn clx-btn-dark">
                                <i class="fa fa-rocket"></i> Get Started Now
                            </a>
                            <a href="/contactus" class="clx-btn clx-btn-white">
                                <i class="fa fa-phone"></i> Talk to Sales
                            </a>
                        </div>
                    </div>
                </section>

            </div>
        </t>
    </template>
</odoo>
