<odoo>
    <data>
        <record id="view_partner_form" model="ir.ui.view">
            <field name="name">res.partner.form.oe</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                
                
                <xpath expr="/form/sheet//field[@name='phone']/.." position="after">
                    <div class="d-flex align-items-baseline w-md-50" name="mobile">
                        <i class="fa fa-fw me-1 fa-mobile text-primary" title="Mobile" />
                        <field
                            name="mobile"
                            class="w-100"
                            widget="phone"
                            placeholder="Mobile"
                        />
                    </div>

                    <field name="partner_code" string="Partner Code" readonly="1"/>

                </xpath>
                
                
                <xpath     expr="//field[@name='company_id']"    position="before" >
                
                    <div>
                        <group>
                        <field name="partner_code" string="Partner Code" readonly="1"/>

                        </group>
                    </div>
                
                
                </xpath>

                <xpath    expr="//field[@name='website']"   position="before" >
                
              
                    <field name="phone2"  widget="phone"/>
                    <field name="mobile2"  widget="phone"/>


                 
                
                </xpath>


            </field>
        </record>
    </data>
</odoo>