<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sale_order_to_po_wizard_form" model="ir.ui.view">
        <field name="name">sale.order.to.po.wizard.form</field>
        <field name="model">sale.order.to.po.wizard</field>
        <field name="arch" type="xml">
            <form string="Convert Sale Order to Purchase Order">
                <sheet>
                    <group>
                        <field name="vendor_id" options='{"no_create": True}'  />
                        <field name="sale_order_id" readonly="1"/>
                    </group>
                    <footer>
                        <button string="Confirm" type="object" name="action_confirm"
                                class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
